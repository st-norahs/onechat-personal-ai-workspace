# Create an AI Gateway key in your Vercel dashboard, then copy this file to .env.
# Never commit your real .env file or put this key in browser code.
AI_GATEWAY_API_KEY=replace-with-your-own-key
# Optional: images per UTC day (1–10). Parent controls can adjust this at runtime.
SALT_AVATAR_DAILY_LIMIT=1
# Optional: override the default image edit model available through AI Gateway.
SALT_IMAGE_MODEL=openai/gpt-image-2
# Optional: Google OAuth Web client ID for user-controlled Drive backup sync.
# Configure the authorized JavaScript origin for your HTTPS deployment and localhost.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-web-client-id
